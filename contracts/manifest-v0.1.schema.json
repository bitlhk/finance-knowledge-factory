{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "manifest.v0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "productId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "recipeDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidateDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifactDigests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "sourceDigests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "validationDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "approvalDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "mode": {
      "enum": [
        "M0_REFERENCE_ONLY"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "productId",
    "recipeDigest",
    "candidateDigest",
    "artifactDigests",
    "sourceDigests",
    "validationDigest",
    "approvalDigest",
    "mode"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:knowledge-core:manifest:v0.1"
}
