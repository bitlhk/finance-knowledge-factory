{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "candidate.v0.1"
    },
    "productId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "recipeDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifactDigests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "testSetDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "productId",
    "recipeDigest",
    "artifactDigests",
    "testSetDigest"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:knowledge-core:candidate:v0.1"
}
