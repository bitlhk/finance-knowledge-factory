{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:knowledge-factory:knowledge-history:v0.1",
  "title":"PROPOSED - requires Harness acknowledgement before implementation",
  "$defs":{
    "query_queryResponse":{"type":"object","additionalProperties":false,"required":["code","decision","evidence","receipt"],"properties":{"code":{"type":"integer","const":0},"decision":{"enum":["EVIDENCE_FOUND","UNKNOWN"]},"receipt":{"$ref":"#/$defs/query_receipt"},"evidence":{"type":"array","maxItems":3,"items":{"type":"object","additionalProperties":false,"required":["clause","quote","originalDigest","chunkId","anchors","sourceDigest"],"properties":{"clause":{"type":"string","minLength":1},"quote":{"type":"string","minLength":1},"originalDigest":{"$ref":"#/$defs/query_hash"},"chunkId":{"type":"string","minLength":1},"sourceDigest":{"$ref":"#/$defs/query_hash"},"anchors":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/query_anchor"}}}}}}},
    "query_receipt":{"type":"object","additionalProperties":false,"required":["schemaVersion","receiptId","coreReceiptDigest","productId","manifest","businessDate","requestId","traceId","sourceDigest","sourceId","sourceRevision","indexDigest","bindingDigest","policyDigest","mode"],"properties":{"schemaVersion":{"const":"knowledge-receipt.v0.1"},"receiptId":{"type":"string","pattern":"^kr-[a-f0-9]{64}$"},"coreReceiptDigest":{"$ref":"#/$defs/query_hash"},"productId":{"$ref":"#/$defs/query_id"},"manifest":{"$ref":"#/$defs/query_hash"},"businessDate":{"$ref":"#/$defs/query_date"},"requestId":{"$ref":"#/$defs/query_id"},"traceId":{"$ref":"#/$defs/query_id"},"sourceDigest":{"$ref":"#/$defs/query_hash"},"sourceId":{"$ref":"#/$defs/query_id"},"sourceRevision":{"type":"integer","minimum":1},"indexDigest":{"$ref":"#/$defs/query_hash"},"bindingDigest":{"$ref":"#/$defs/query_hash"},"policyDigest":{"$ref":"#/$defs/query_hash"},"mode":{"const":"M2_ISOLATED_DOCUMENT"}}},
    "query_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "query_id":{"type":"string","pattern":"^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"},
    "query_date":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "query_anchor":{"type":"object","additionalProperties":false,"required":["schemaVersion","sourceBytesDigest","mediaType","locatorKind","locator","quote","quoteDigest"],"properties":{"schemaVersion":{"const":"evidence-anchor.v0.1"},"sourceBytesDigest":{"$ref":"#/$defs/query_hash"},"mediaType":{"const":"text/html"},"locatorKind":{"const":"HTML_DOM_TEXT"},"quote":{"type":"string","minLength":1},"quoteDigest":{"$ref":"#/$defs/query_hash"},"locator":{"type":"object","additionalProperties":false,"required":["xpath","start","end"],"properties":{"xpath":{"type":"string","minLength":1},"start":{"type":"integer","minimum":0},"end":{"type":"integer","minimum":1}}}}},
    "hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "id":{"type":"string","pattern":"^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"},
    "identity":{"type":"string","minLength":1,"maxLength":4096},
    "timestamp":{"type":"string","format":"date-time"},
    "request":{
      "type":"object","additionalProperties":false,
      "required":["schemaVersion","requestId","traceId","coreReceiptDigest","expected"],
      "properties":{
        "schemaVersion":{"const":"knowledge-history.v0.1"},
        "requestId":{"$ref":"#/$defs/id"},"traceId":{"$ref":"#/$defs/id"},
        "coreReceiptDigest":{"$ref":"#/$defs/hash"},
        "expected":{
          "type":"object","additionalProperties":false,
          "required":["productId","manifest","sourceDigest","sourceRevision","originalRequestId","originalTraceId"],
          "properties":{
            "productId":{"$ref":"#/$defs/id"},"manifest":{"$ref":"#/$defs/hash"},
            "sourceDigest":{"$ref":"#/$defs/hash"},"sourceRevision":{"type":"integer","minimum":1},
            "originalRequestId":{"$ref":"#/$defs/id"},"originalTraceId":{"$ref":"#/$defs/id"}
          }
        }
      }
    },
    "savedReceipt":{
      "type":"object","additionalProperties":false,
      "required":["schemaVersion","requestId","traceId","principal","productId","manifestDigest","indexDigest","sourceDigest","bindingDigest","policyDigest","question","hostAuthority","businessContextSource","host","result","createdAt","mode"],
      "properties":{
        "schemaVersion":{"const":"document-receipt.v0.1"},
        "requestId":{"$ref":"#/$defs/id"},"traceId":{"$ref":"#/$defs/id"},
        "principal":{"$ref":"#/$defs/id"},"productId":{"$ref":"#/$defs/id"},
        "manifestDigest":{"$ref":"#/$defs/hash"},"indexDigest":{"$ref":"#/$defs/hash"},
        "sourceDigest":{"$ref":"#/$defs/hash"},"bindingDigest":{"$ref":"#/$defs/hash"},
        "policyDigest":{"$ref":"#/$defs/hash"},"question":{"$ref":"#/$defs/identity"},
        "hostAuthority":{"$ref":"#/$defs/identity"},"businessContextSource":{"$ref":"#/$defs/identity"},
        "host":{"type":"object"},"result":{"type":"object"},
        "createdAt":{"$ref":"#/$defs/identity"},"mode":{"const":"M2_ISOLATED_DOCUMENT"}
      }
    },
    "response":{
      "type":"object","additionalProperties":false,
      "required":["schemaVersion","code","replay","requestId","traceId","coreReceiptDigest","savedReceipt","queryResponse"],
      "properties":{
        "schemaVersion":{"const":"knowledge-history.v0.1"},"code":{"type":"integer","const":0},
        "replay":{"const":true},"requestId":{"$ref":"#/$defs/id"},"traceId":{"$ref":"#/$defs/id"},
        "coreReceiptDigest":{"$ref":"#/$defs/hash"},"savedReceipt":{"$ref":"#/$defs/savedReceipt"},
        "queryResponse":{"$ref":"#/$defs/query_queryResponse"}
      }
    },
    "error":{
      "type":"object","additionalProperties":false,"required":["code","error"],
      "properties":{
        "code":{"type":"integer","enum":[400,403,409,413,503]},
        "error":{"enum":["HISTORY_REQUEST_INVALID","HISTORY_AUTH_REQUIRED","HISTORY_FORBIDDEN","HISTORY_REFERENCE_MISMATCH","HISTORY_INTEGRITY_FAILED","HISTORY_RESPONSE_LIMIT","HISTORY_UNAVAILABLE"]}
      }
    },
    "hostAuthority":{
      "type":"object","additionalProperties":false,
      "required":["schemaVersion","enabled","ownerRef","principalId","tenant","authority","purpose","productId","manifest","allowedReceiptDigests","expiresAt","leaseDirectory"],
      "properties":{
        "schemaVersion":{"const":"knowledge-history-authority.v0.1"},"enabled":{"type":"boolean"},
        "ownerRef":{"$ref":"#/$defs/identity"},"principalId":{"$ref":"#/$defs/id"},
        "tenant":{"$ref":"#/$defs/identity"},"authority":{"$ref":"#/$defs/identity"},
        "purpose":{"const":"knowledge.history.read"},
        "productId":{"$ref":"#/$defs/id"},"manifest":{"$ref":"#/$defs/hash"},
        "allowedReceiptDigests":{"type":"array","minItems":1,"maxItems":100,"uniqueItems":true,"items":{"$ref":"#/$defs/hash"}},
        "expiresAt":{"$ref":"#/$defs/timestamp"},"leaseDirectory":{"$ref":"#/$defs/identity"}
      }
    },
    "hostLease":{
      "type":"object","additionalProperties":false,
      "required":["schemaVersion","policyDigest","ownerRef","viewerSessionRef","expiresAt"],
      "properties":{
        "schemaVersion":{"const":"knowledge-history-lease.v0.1"},"policyDigest":{"$ref":"#/$defs/hash"},
        "ownerRef":{"$ref":"#/$defs/identity"},"viewerSessionRef":{"$ref":"#/$defs/identity"},
        "expiresAt":{"$ref":"#/$defs/timestamp"}
      }
    }
  }
}
