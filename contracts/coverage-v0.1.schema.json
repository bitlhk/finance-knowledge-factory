{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "coverage.v0.1"
    },
    "candidateDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "lineStart": {
            "type": "integer",
            "minimum": 1
          },
          "lineEnd": {
            "type": "integer",
            "minimum": 1
          },
          "disposition": {
            "enum": [
              "MODELED",
              "NON_NORMATIVE",
              "UNRESOLVED"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "ruleIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
            },
            "minItems": 0,
            "maxItems": 100,
            "uniqueItems": true
          }
        },
        "required": [
          "sourceDigest",
          "lineStart",
          "lineEnd",
          "disposition",
          "reason",
          "ruleIds"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "actor": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "authorityRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  },
  "required": [
    "schemaVersion",
    "candidateDigest",
    "entries",
    "actor",
    "authorityRef"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:knowledge-core:coverage:v0.1"
}
