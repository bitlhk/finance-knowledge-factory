    "P13": {
      "source": {
        "schemaVersion": "source-revision.v0.1",
        "id": "lowering-P13",
        "revision": 1,
        "mediaType": "text/plain",
        "content": "第十三条  贷款人应要求借款人以书面形式提出个人贷款申请，并要求借款人提供能够证明其符合贷款条件的相关资料。",
